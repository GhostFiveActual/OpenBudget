{
  "name": "openbudget",
  "version": "3.1.3",
  "private": false,
  "type": "module",
  "description": "A private, offline-first, open-source personal finance desktop application.",
  "author": {
    "name": "GhostFiveActual",
    "email": "brandonsutan@gmail.com"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/engine.test.mjs && node tests/store.test.mjs && node tests/release.test.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.openbudget.desktop",
    "productName": "OpenBudget",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "README.md",
      "SECURITY.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "OpenBudget-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "artifactName": "OpenBudget-${version}-macOS.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "desktopName": "OpenBudget",
      "syncDesktopName": true,
      "artifactName": "OpenBudget-${version}-Linux-${arch}.${ext}"
    }
  }
}