{
  "name": "ownledger",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A free, open-source, offline-first personal finance and financial decision desktop application.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env OPENBUDGET_DEV=1 electron .\"",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "test": "node tests/engine.test.mjs && node tests/store.test.mjs && node tests/release.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.ownledger.desktop",
    "productName": "OwnLedger",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "README.md",
      "SECURITY.md"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "OwnLedger-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "artifactName": "OwnLedger-${version}-macOS.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "GhostFiveActual <brandonsutan@gmail.com>",
      "artifactName": "OwnLedger-${version}-Linux-${arch}.${ext}"
    }
  },
  "license": "MIT",
  "author": {
    "name": "GhostFiveActual",
    "email": "brandonsutan@gmail.com"
  },
  "desktopName": "org.ownledger.desktop"
}
